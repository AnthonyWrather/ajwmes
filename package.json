{
  "name": "ajwmes",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:functions": "npm run --prefix functions lint",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "test:functions": "npm run --prefix functions test",
    "build:functions": "npm run --prefix functions build",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:all": "ALL_BROWSERS=true playwright test",
    "record:manuals": "playwright test --config=playwright.training.config.ts",
    "process:videos": "node scripts/process-training-videos.js",
    "validate": "npm run lint && npm run test:unit && npm run build && npm run test:functions && npm run build:functions"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
