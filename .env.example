# =============================================================
# AJW Marine Electrical Services — Environment Variables Template
# =============================================================
# Copy this file to `.env` (gitignored) and fill in the values:
#   cp .env.example .env
#
# Full step-by-step instructions for creating every account, key and
# endpoint (Firebase, Firestore, Stripe, Resend, Gemini, GitHub Actions):
#   docs/SERVICES_SETUP.md
#
# IMPORTANT: Every VITE_* variable is inlined into the PUBLIC browser
# bundle at build time. Never put true secrets (service accounts, Stripe
# secret keys sk_..., private server keys) in a VITE_* variable.
# =============================================================

# -------------------------------------------------------------
# Google Gemini (optional AI features)
# -------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Obtain from https://aistudio.google.com/apikey (NOT valid as a Firebase key).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# Firebase Web App Configuration (docs/SERVICES_SETUP.md §4)
# -------------------------------------------------------------
# Firebase Console -> Project settings -> Your apps -> Web app config.
# NOTE: Never commit your actual API keys to GitHub.
# Any value left EMPTY falls back to the committed firebase-applet-config.json,
# so the app still boots against the default project. Fill these in only when
# pointing at your own Firebase project.
VITE_FIREBASE_API_KEY=""                       # e.g. AIza...
VITE_FIREBASE_PROJECT_ID=""                    # e.g. ajwmes-prod
VITE_FIREBASE_APP_ID=""                        # e.g. 1:000000000000:web:abc123...
VITE_FIREBASE_AUTH_DOMAIN=""                   # e.g. ajwmes-prod.firebaseapp.com
# Firestore database ID: "(default)" or the exact name of a named database.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""                # e.g. ajwmes-prod.firebasestorage.app
# The following three are currently read ONLY from firebase-applet-config.json;
# listed here for reference — update that file when changing projects.
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""                # e.g. G-XXXXXXXXXX
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# -------------------------------------------------------------
# Stripe Payment Gateway Configuration (docs/SERVICES_SETUP.md §5)
# -------------------------------------------------------------
# 1. VITE_STRIPE_PUBLISHABLE_KEY:
#    Client-safe Stripe Publishable Key (pk_test_... or pk_live_...).
#    Obtain from Stripe Dashboard -> Developers -> API keys.
#    Safe for client-side Vite builds. NEVER put secret keys (sk_...) here!
#    Use pk_test_... for development/preview and pk_live_... for production only.
#    Leave empty to run in Simulated payment mode.
VITE_STRIPE_PUBLISHABLE_KEY=""

# Optional Direct Stripe Payment Links (Hosted Checkout with 0 backend):
# Create these in Stripe Dashboard -> More -> Payment Links
VITE_STRIPE_PAYMENT_LINK_DEPOSIT=""
VITE_STRIPE_PAYMENT_LINK_STORE=""

# -------------------------------------------------------------
# Resend Transactional Email (docs/SERVICES_SETUP.md §6)
# -------------------------------------------------------------
# WARNING: This key is currently shipped in the browser bundle. Leave it EMPTY
# (Simulated Outbox mode) for shared/deployed builds until email sending moves
# to a server-side Cloud Function (GitHub Issue #20). If you must use it, create
# a "Sending access" key restricted to your verified domain only.
VITE_RESEND_API_KEY=""
# Must be on a Resend-verified domain. Before verification use:
#   AJW Marine <onboarding@resend.dev>
VITE_RESEND_FROM_EMAIL="AJW Marine <notifications@ajwmes.co.uk>"
VITE_RESEND_REPLY_TO="info@ajwmes.co.uk"

# -------------------------------------------------------------
# ShipStation Carrier Postal Dispatch (docs/SERVICES_SETUP.md §7)
# -------------------------------------------------------------
# Leave empty to run in Simulated Mode (generates deterministic
# 4x6" thermal labels with Royal Mail & DPD barcodes).
# In Phase 2, API keys & secrets reside strictly in Google Secret
# Manager for Firebase Cloud Functions backend execution.
VITE_SHIPSTATION_API_KEY=""
