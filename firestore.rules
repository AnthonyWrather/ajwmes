rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Healthcheck test connection
    match /test/{docId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Marine hardware catalog (Public browse, Admin & app update)
    match /catalog/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create, update, delete: if isValidId(itemId);
    }

    // Client diagnostics, quotes, and installation jobs
    match /jobs/{jobId} {
      allow get: if isValidId(jobId);
      allow list: if true;
      allow create, update, delete: if isValidId(jobId);
    }

    // Customer postal orders and tracking
    match /postal_orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create, update, delete: if isValidId(orderId);
    }

    // Vessel electrical specification profiles
    match /vessel_specs/{specId} {
      allow get: if isValidId(specId);
      allow list: if true;
      allow create, update, delete: if isValidId(specId);
    }

    // Low inventory stock alerts
    match /stock_alerts/{alertId} {
      allow get: if isValidId(alertId);
      allow list: if true;
      allow create, update, delete: if isValidId(alertId);
    }

    // Custom switch panel laser designs
    match /panel_configs/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update, delete: if isValidId(configId);
    }
  }
}
