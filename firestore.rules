rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Healthcheck test connection
    match /test/{docId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // User profile documents (Firebase Authentication & RBAC)
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update, delete: if isValidId(userId);
    }
    match /{colPrefix_users}/{userId} {
      allow get: if colPrefix_users.matches('^(ais_dev_|ais_pre_|gh_pre_)users$') && isValidId(userId);
      allow list: if colPrefix_users.matches('^(ais_dev_|ais_pre_|gh_pre_)users$');
      allow create, update, delete: if colPrefix_users.matches('^(ais_dev_|ais_pre_|gh_pre_)users$') && isValidId(userId);
    }

    // Marine hardware catalog (Public browse, Admin & app update)
    match /catalog/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create, update, delete: if isValidId(itemId);
    }
    match /{colPrefix_catalog}/{itemId} {
      allow get: if colPrefix_catalog.matches('^(ais_dev_|ais_pre_|gh_pre_)catalog$') && isValidId(itemId);
      allow list: if colPrefix_catalog.matches('^(ais_dev_|ais_pre_|gh_pre_)catalog$');
      allow create, update, delete: if colPrefix_catalog.matches('^(ais_dev_|ais_pre_|gh_pre_)catalog$') && isValidId(itemId);
    }

    // Hardware product categories (Public browse, Admin & app update)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update, delete: if isValidId(categoryId);
    }
    match /{colPrefix_categories}/{categoryId} {
      allow get: if colPrefix_categories.matches('^(ais_dev_|ais_pre_|gh_pre_)categories$') && isValidId(categoryId);
      allow list: if colPrefix_categories.matches('^(ais_dev_|ais_pre_|gh_pre_)categories$');
      allow create, update, delete: if colPrefix_categories.matches('^(ais_dev_|ais_pre_|gh_pre_)categories$') && isValidId(categoryId);
    }

    // Client diagnostics, quotes, and installation jobs
    match /jobs/{jobId} {
      allow get: if isValidId(jobId);
      allow list: if true;
      allow create, update, delete: if isValidId(jobId);
    }
    match /{colPrefix_jobs}/{jobId} {
      allow get: if colPrefix_jobs.matches('^(ais_dev_|ais_pre_|gh_pre_)jobs$') && isValidId(jobId);
      allow list: if colPrefix_jobs.matches('^(ais_dev_|ais_pre_|gh_pre_)jobs$');
      allow create, update, delete: if colPrefix_jobs.matches('^(ais_dev_|ais_pre_|gh_pre_)jobs$') && isValidId(jobId);
    }

    // Customer postal orders and tracking
    match /postal_orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create, update, delete: if isValidId(orderId);
    }
    match /{colPrefix_orders}/{orderId} {
      allow get: if colPrefix_orders.matches('^(ais_dev_|ais_pre_|gh_pre_)postal_orders$') && isValidId(orderId);
      allow list: if colPrefix_orders.matches('^(ais_dev_|ais_pre_|gh_pre_)postal_orders$');
      allow create, update, delete: if colPrefix_orders.matches('^(ais_dev_|ais_pre_|gh_pre_)postal_orders$') && isValidId(orderId);
    }

    // Vessel electrical specification profiles
    match /vessel_specs/{specId} {
      allow get: if isValidId(specId);
      allow list: if true;
      allow create, update, delete: if isValidId(specId);
    }
    match /{colPrefix_specs}/{specId} {
      allow get: if colPrefix_specs.matches('^(ais_dev_|ais_pre_|gh_pre_)vessel_specs$') && isValidId(specId);
      allow list: if colPrefix_specs.matches('^(ais_dev_|ais_pre_|gh_pre_)vessel_specs$');
      allow create, update, delete: if colPrefix_specs.matches('^(ais_dev_|ais_pre_|gh_pre_)vessel_specs$') && isValidId(specId);
    }

    // Low inventory stock alerts
    match /stock_alerts/{alertId} {
      allow get: if isValidId(alertId);
      allow list: if true;
      allow create, update, delete: if isValidId(alertId);
    }
    match /{colPrefix_alerts}/{alertId} {
      allow get: if colPrefix_alerts.matches('^(ais_dev_|ais_pre_|gh_pre_)stock_alerts$') && isValidId(alertId);
      allow list: if colPrefix_alerts.matches('^(ais_dev_|ais_pre_|gh_pre_)stock_alerts$');
      allow create, update, delete: if colPrefix_alerts.matches('^(ais_dev_|ais_pre_|gh_pre_)stock_alerts$') && isValidId(alertId);
    }

    // Custom switch panel laser designs
    match /panel_configs/{configId} {
      allow get: if isValidId(configId);
      allow list: if true;
      allow create, update, delete: if isValidId(configId);
    }
    match /{colPrefix_panels}/{configId} {
      allow get: if colPrefix_panels.matches('^(ais_dev_|ais_pre_|gh_pre_)panel_configs$') && isValidId(configId);
      allow list: if colPrefix_panels.matches('^(ais_dev_|ais_pre_|gh_pre_)panel_configs$');
      allow create, update, delete: if colPrefix_panels.matches('^(ais_dev_|ais_pre_|gh_pre_)panel_configs$') && isValidId(configId);
    }

    // Marine workshop and technician job expenses
    match /expenses/{expenseId} {
      allow get: if isValidId(expenseId);
      allow list: if true;
      allow create, update, delete: if isValidId(expenseId);
    }
    match /{colPrefix_expenses}/{expenseId} {
      allow get: if colPrefix_expenses.matches('^(ais_dev_|ais_pre_|gh_pre_)expenses$') && isValidId(expenseId);
      allow list: if colPrefix_expenses.matches('^(ais_dev_|ais_pre_|gh_pre_)expenses$');
      allow create, update, delete: if colPrefix_expenses.matches('^(ais_dev_|ais_pre_|gh_pre_)expenses$') && isValidId(expenseId);
    }
  }
}
